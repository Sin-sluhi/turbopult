# Общее
PUBLIC_URL=https://your-domain.ru
DB_PATH=crm.db
OPERATOR_NAME=Кирилл

# Telegram: токен у @BotFather — единственное, что нужно для старта
TELEGRAM_TOKEN=

# polling — опрашиваем Telegram сами, домен и сертификат не нужны
# webhook — события приходят на PUBLIC_URL, нужен HTTPS-домен
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=change-me-telegram

# MAX: токен на платформе для партнёров, Чат-боты -> ... -> Настройки
# Секрет: только A-Z a-z 0-9 и дефис, от 5 до 256 символов
MAX_TOKEN=
MAX_WEBHOOK_SECRET=change-me-max

# Строка «Спросить у базы»: с ключом вопросы любой формы разбирает Claude.
# Без ключа работает встроенный разбор.
ANTHROPIC_API_KEY=
